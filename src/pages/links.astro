---
import Base from '../layouts/Base.astro';
import SocialList from '../components/SocialList.astro';

const description = 'YouTube 频道是 @吴宗臻。TikTok 与 X 仍是 TODO 占位。';
---

<Base title="链接" description={description}>
  <p class="eyebrow">链接</p>
  <h1>YouTube 已填上，其余仍是占位。</h1>
  <div class="prose">
    <p>
      YouTube 指向 <a href="https://www.youtube.com/@吴宗臻">@吴宗臻</a>。TikTok 和 X 仍标了 <strong>TODO</strong>，网址里带有 <code>TODO-peteerli</code>，还不是生效的账号。
    </p>
    <p>替换占位地址时只改 <code>src/data/social.ts</code> 里的 <code>href</code> 和 <code>handle</code>，首页和本页会一起更新。</p>
  </div>
  <div class="section">
    <SocialList />
  </div>
</Base>
